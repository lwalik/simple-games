{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "version": 1,
  "projects": {
    "main": {
      "root": "apps/main",
      "projectType": "application",
      "sourceRoot": "apps/main/src",
      "prefix": "simple-games",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "outputs": ["{options.outputPath}"],
          "options": {
            "outputPath": "dist/apps/main",
            "index": "apps/main/src/index.html",
            "main": "apps/main/src/main.ts",
            "polyfills": "apps/main/src/polyfills.ts",
            "tsConfig": "apps/main/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["apps/main/src/favicon.ico", "apps/main/src/assets"],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/purple-green.css",
              "apps/main/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "apps/main/src/environments/environment.ts",
                  "with": "apps/main/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production",
          "dependsOn": ["^build"]
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "browserTarget": "main:build:production" },
            "development": { "browserTarget": "main:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": { "browserTarget": "main:build" }
        },
        "lint": {
          "builder": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["apps/main/**/*.ts", "apps/main/**/*.html"]
          }
        },
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/apps/main"],
          "options": {
            "jestConfig": "apps/main/jest.config.ts",
            "passWithNoTests": true
          }
        },
        "deploy": {
          "builder": "@angular/fire:deploy",
          "options": {
            "prerender": false,
            "ssr": false,
            "browserTarget": "main:build:production",
            "firebaseProject": "simple-games-ed744",
            "firebaseHostingSite": "simple-games-ed744"
          }
        }
      },
      "tags": []
    },
    "main-e2e": {
      "root": "apps/main-e2e",
      "$schema": "../../node_modules/nx/schemas/project-schema.json",
      "sourceRoot": "apps/main-e2e/src",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@nrwl/cypress:cypress",
          "options": {
            "cypressConfig": "apps/main-e2e/cypress.json",
            "devServerTarget": "main:serve:development"
          },
          "configurations": {
            "production": { "devServerTarget": "main:serve:production" }
          }
        },
        "lint": {
          "builder": "@nrwl/linter:eslint",
          "outputs": ["{options.outputFile}"],
          "options": { "lintFilePatterns": ["apps/main-e2e/**/*.{js,ts}"] }
        }
      },
      "tags": [],
      "implicitDependencies": ["main"]
    },
    "rock-paper-scissors": {
      "projectType": "library",
      "root": "libs/rock-paper-scissors",
      "sourceRoot": "libs/rock-paper-scissors/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/rock-paper-scissors"],
          "options": {
            "jestConfig": "libs/rock-paper-scissors/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "navigation": {
      "projectType": "library",
      "root": "libs/navigation",
      "sourceRoot": "libs/navigation/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/navigation"],
          "options": {
            "jestConfig": "libs/navigation/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "users": {
      "projectType": "library",
      "root": "libs/users",
      "sourceRoot": "libs/users/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/users"],
          "options": {
            "jestConfig": "libs/users/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "games-library": {
      "projectType": "library",
      "root": "libs/games-library",
      "sourceRoot": "libs/games-library/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/games-library"],
          "options": {
            "jestConfig": "libs/games-library/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "libs/core",
      "sourceRoot": "libs/core/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/core"],
          "options": {
            "jestConfig": "libs/core/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "hangman": {
      "projectType": "library",
      "root": "libs/hangman",
      "sourceRoot": "libs/hangman/src",
      "prefix": "lib",
      "architect": {
        "test": {
          "builder": "@nrwl/jest:jest",
          "outputs": ["coverage/hangman"],
          "options": {
            "jestConfig": "libs/hangman/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    }
  },
  "npmScope": "simple-games",
  "affected": { "defaultBase": "main" },
  "implicitDependencies": {
    "package.json": { "dependencies": "*", "devDependencies": "*" },
    ".eslintrc.json": "*"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": { "cacheableOperations": ["build", "lint", "test", "e2e"] }
    }
  },
  "targetDefaults": { "build": { "dependsOn": ["^build"] } },
  "cli": { "analytics": false }
}
